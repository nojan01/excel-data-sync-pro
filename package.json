{
  "name": "excel-data-sync-pro",
  "version": "1.8.0",
  "description": "Excel Data Sync Pro - Daten zwischen Excel-Dateien synchronisieren",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron --max-old-space-size=4096 --expose-gc .",
    "dev": "electron --max-old-space-size=4096 --expose-gc . --dev",
    "build:win": "electron-builder --win nsis --x64",
    "build:win-arm64": "electron-builder --win nsis --arm64"
  },
  "build": {
    "appId": "de.excelsync.pro",
    "productName": "Excel Data Sync Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "exceljs-reader.js",
      "exceljs-writer.js",
      "src/**/*",
      "python/**/*",
      "!python/__pycache__"
    ],
    "asarUnpack": [
      "python/**",
      "python-embed/**"
    ],
    "fileAssociations": [
      {
        "ext": "xlsx",
        "name": "Excel Workbook",
        "description": "Microsoft Excel Workbook",
        "role": "Viewer"
      },
      {
        "ext": "xls",
        "name": "Excel 97-2003 Workbook",
        "description": "Microsoft Excel 97-2003 Workbook",
        "role": "Viewer"
      },
      {
        "ext": "xlsm",
        "name": "Excel Macro-Enabled Workbook",
        "description": "Microsoft Excel Macro-Enabled Workbook",
        "role": "Viewer"
      }
    ],
    "win": {
      "files": [
        "python-embed/win-x64/**/*"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "artifactName": "Excel-Data-Sync-Pro-${version}-Setup-${arch}.exe",
      "shortcutName": "Excel Data Sync Pro",
      "perMachine": false,
      "runAfterFinish": false,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": true
    },
    "portable": {
      "artifactName": "Excel-Data-Sync-Pro-${arch}.exe"
    }
  },
  "author": "Norbert Jander",
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^9.39.2"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "exceljs": "^4.4.0",
    "ssf": "^0.11.2",
    "xlsx-populate": "^1.21.0"
  }
}
